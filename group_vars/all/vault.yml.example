---
# Copy to group_vars/all/vault.yml, fill in, then encrypt:
#   ansible-vault encrypt group_vars/all/vault.yml
# Generate passwords with: openssl rand -hex 24
# (letters/digits only: nothing to escape anywhere. The code still handles
# special characters, but there is no reason to use them.)

vault_db_password: CHANGE_ME
vault_db_root_password: CHANGE_ME
vault_wp_admin_user: CHANGE_ME          # avoid "admin": first name bots try
vault_wp_admin_password: CHANGE_ME
vault_wp_admin_email: you@example.com
vault_letsencrypt_email: you@example.com
